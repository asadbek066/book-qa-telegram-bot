# Telegram Bot Token
TELEGRAM_BOT_TOKEN=your_token_here

# Optional: override the revision of the default embedding model. Leave the
# value empty to follow the Hub default, for example when the pinned revision
# is not available offline.
# EMBEDDING_MODEL_REVISION=1110a243fdf4706b3f48f1d95db1a4f5529b4d41

# Optional: opt-in "not found" replies. Minimum cosine similarity (-1..1) between a
# question and the best book chunk; below it the bot says it could not find the answer.
# Default 0.0 is effectively off. The model is English-centric, so genuine matches in
# other languages or for terse questions can score only 0.05-0.2: calibrate first by
# enabling DEBUG logging for "book_qa", sampling top scores for good and off-topic
# questions on your own books, then set a value between the two groups.
# MIN_SIMILARITY_SCORE=0.0
